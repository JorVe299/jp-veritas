# Copy to .env (gitignored, placed on the server by hand); every setting exists exactly once

# --- Database ------------------------------------------------------------
# The FiveM server's database: grep -ri "mysql_connection_string" /path/to/txData/
# A wrong database looks exactly like everyone being offline
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Backend -------------------------------------------------------------
PORT=3001

# --- FiveM resource ------------------------------------------------------
# veritas resource folder: source of jobs/gangs/items/vehicles.json for the pickers
FIVEM_JSON_PATH=

# Bridge: FiveM HTTP port + resource name; 127.0.0.1 when on the same host
FIVEM_API_URL=http://127.0.0.1:30120/veritas

# Bridge timeout in ms; the first call after idle is slow, do not go lower
BRIDGE_TIMEOUT=2500

# Same value as Config.Token in the bridge; enforced with Config.RequireTokenEverywhere
# Generate: openssl rand -hex 32
BRIDGE_TOKEN=

# --- Discord sign-in -----------------------------------------------------
# Developer Portal -> Applications -> OAuth2; list the redirect URI there exactly as below
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Needed for Discord role mappings and for Veritas ID (guild membership)
DISCORD_GUILD_ID=

# --- Roles ---------------------------------------------------------------
# Owner, Administrator, Supporter, Citizen; highest match wins; rights are set in the panel
# Ids: Discord developer mode -> right-click -> Copy ID; several comma-separated

# By Discord user id
DISCORD_OWNER_IDS=
DISCORD_ADMINISTRATOR_IDS=
DISCORD_SUPPORTER_IDS=
DISCORD_CITIZEN_IDS=

# By Discord role id (needs DISCORD_GUILD_ID); never the guild id itself (= @everyone)
DISCORD_ROLE_OWNER=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_SUPPORTER=
DISCORD_ROLE_CITIZEN=

# --- Session -------------------------------------------------------------
# Signs the session cookie; empty = every restart signs everyone out (openssl rand -hex 32)
SESSION_SECRET=
SESSION_HOURS=12

# true only behind HTTPS (Caddy, nginx); over http://ip:3001 a secure cookie never arrives
COOKIE_SECURE=false

# --- Inventory -----------------------------------------------------------
# Slots and max weight in grams (ox_inventory defaults: 50 / 85000)
INVENTORY_SLOTS=50
INVENTORY_MAX_WEIGHT=85000

# ox_inventory icon folder (.../ox_inventory/web/images); empty = found from FIVEM_JSON_PATH
ITEM_IMAGE_PATH=

# --- txAdmin -------------------------------------------------------------
# txAdmin's playersDB.json, read-only (bans for Veritas ID and the panel's ban list)
# Accepts txData, a profile folder or the file; empty = look for txData near the panel
TXADMIN_DB_PATH=

# Show players which admin issued their ban (off: they see the reason only)
TXADMIN_SHOW_BAN_AUTHOR=false

# --- Development ---------------------------------------------------------
# Vite dev server (e.g. http://localhost:5173): CORS origin and sign-in return target
# Empty in production: the backend serves the panel itself (same origin)
PANEL_ORIGIN=
