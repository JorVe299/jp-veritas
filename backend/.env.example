# Kopie anlegen als .env und ausfuellen. Die .env selbst ist gitignored.

# --- Datenbank -----------------------------------------------------------
# Muss die Datenbank sein, die der FiveM-Server beschreibt. Nachsehen mit:
#   grep -ri "mysql_connection_string" /pfad/zu/txData/
# Eine falsche Datenbank hier sieht im Panel so aus, als waere jeder offline.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=3001

# --- FiveM Resource ------------------------------------------------------
# Ordner der jp-veritas Resource. Von dort holt das Backend jobs.json,
# items.json und vehicles.json fuer die Auswahllisten.
FIVEM_JSON_PATH=

# Live-Bridge: FiveM HTTP-Port + Resource-Name. 127.0.0.1, wenn Backend und
# Gameserver auf demselben Host laufen - der Umweg ueber die oeffentliche
# Adresse kostet nur Latenz.
FIVEM_API_URL=http://127.0.0.1:30120/jp-veritas

# Timeout fuer Bridge-Aufrufe in ms. Der erste Aufruf nach Leerlauf braucht
# spuerbar laenger als die folgenden - darunter bitte nicht gehen.
BRIDGE_TIMEOUT=2500

# --- Discord Login -------------------------------------------------------
# Discord Developer Portal -> Applications -> OAuth2.
# DISCORD_REDIRECT_URI muss dort unter "Redirects" EXAKT eingetragen sein,
# inklusive Protokoll, Port und Pfad.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Zugang: mindestens eine der beiden Listen muss gefuellt sein, sonst kommt
# niemand durch. Mehrere Werte mit Komma trennen.
# IDs kopieren: in Discord den Entwicklermodus aktivieren, dann Rechtsklick
# auf den Nutzer bzw. die Rolle -> "ID kopieren".

# Einzelne Nutzer, die immer Zugang haben (unabhaengig von Rollen)
DISCORD_ADMIN_IDS=

# Oder rollenbasiert: Server-ID plus die Rollen, die Zugang bekommen
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=

# --- Sitzung -------------------------------------------------------------
# Signiert das Sitzungscookie. Fehlt der Wert, wird bei jedem Neustart ein
# zufaelliges Secret erzeugt und alle sind abgemeldet.
#   openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=12

# Nur true, wenn das Panel ueber HTTPS laeuft (z.B. hinter Caddy/nginx).
# Bei http://ip:3001 wuerde ein secure-Cookie nie ankommen.
COOKIE_SECURE=false

# --- Nur fuer die Entwicklung --------------------------------------------
# Origin des Vite-Dev-Servers, damit das Cookie durch den Proxy kommt.
CORS_ORIGIN=http://localhost:5173
# Wohin nach der Anmeldung zurueckgesprungen wird. Im Betrieb leer lassen,
# dann liefert dasselbe Backend das Panel unter '/' aus.
PANEL_URL=

# --- Inventar ------------------------------------------------------------
# Plaetze und Maximalgewicht in Gramm (ox_inventory Standard: 41 / 30000).
INVENTORY_SLOTS=41
INVENTORY_MAX_WEIGHT=30000
# Ordner mit den ox_inventory Icons (.../ox_inventory/web/images).
# Leer lassen: das Backend sucht ihn selbst ausgehend von FIVEM_JSON_PATH.
ITEM_IMAGE_PATH=
