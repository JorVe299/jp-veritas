# Copy this to .env and fill it in. The .env itself is gitignored and is not
# deployed - it has to be placed on the server by hand.
#
# Every setting appears exactly once. Where two ways to the same goal would
# exist, there is deliberately only one.

# --- Database ------------------------------------------------------------
# Must be the database the FiveM server writes to. Find it with:
#   grep -ri "mysql_connection_string" /path/to/txData/
# The wrong database looks, in the panel, exactly like everyone being offline.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Backend -------------------------------------------------------------
PORT=3001

# --- FiveM resource ------------------------------------------------------
# Folder of the veritas resource. It supplies jobs.json, gangs.json,
# items.json and vehicles.json for the pickers.
FIVEM_JSON_PATH=

# Live bridge: FiveM HTTP port plus resource name. Use 127.0.0.1 while the
# backend and the game server run on the same host - going out via the public
# address only costs latency.
FIVEM_API_URL=http://127.0.0.1:30120/veritas

# Timeout for bridge calls in ms. The first call after an idle period takes
# noticeably longer than the ones after it - do not go below this.
BRIDGE_TIMEOUT=2500

# Shared secret with the bridge resource (Config.Token over there).
# Calling exports on arbitrary resources stays closed until both sides
# carry the same value. openssl rand -hex 32
BRIDGE_TOKEN=

# --- Discord sign-in -----------------------------------------------------
# Discord Developer Portal -> Applications -> OAuth2.
# DISCORD_REDIRECT_URI has to be listed there under "Redirects" character for
# character, including protocol, port and path.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Only needed when Discord roles are mapped below.
DISCORD_GUILD_ID=

# --- Roles ---------------------------------------------------------------
# Four roles: Owner, Administrator, Supporter, Citizen.
# Two ways to assign each - individual users or a Discord role. Whoever
# matches several gets the highest one.
#
# What a role MAY do is not set here but in the panel under "Permissions"
# (only the owner sees it), and it lands in backend/data/permissions.json.
# The owner's own rights are fixed and cannot be unticked - otherwise you
# could lock yourself out.
#
# Copying ids: enable developer mode in Discord, then right-click a user or a
# role -> "Copy ID". Separate several with commas.

# Individual Discord users:
DISCORD_OWNER_IDS=
DISCORD_ADMINISTRATOR_IDS=
DISCORD_SUPPORTER_IDS=
DISCORD_CITIZEN_IDS=

# Or via Discord roles (needs DISCORD_GUILD_ID).
# Do not enter the guild id itself - that would be @everyone.
DISCORD_ROLE_OWNER=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_SUPPORTER=
DISCORD_ROLE_CITIZEN=

# Deprecated: DISCORD_ADMIN_IDS and DISCORD_ADMIN_ROLE_IDS existed before the
# roles. They are still read and count as Owner, but report themselves as
# deprecated at startup. For a fresh setup use the variables above instead.

# --- Session -------------------------------------------------------------
# Signs the session cookie. Without it every restart signs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=12

# Only true when the panel runs over HTTPS (behind Caddy or nginx, say).
# Over http://ip:3001 a secure cookie would never arrive.
COOKIE_SECURE=false

# --- Inventory -----------------------------------------------------------
# Slots and maximum weight in grams (ox_inventory defaults: 41 / 30000).
INVENTORY_SLOTS=41
INVENTORY_MAX_WEIGHT=30000

# Folder holding the ox_inventory icons (.../ox_inventory/web/images).
# Leave empty: it is found automatically starting from FIVEM_JSON_PATH.
ITEM_IMAGE_PATH=

# --- txAdmin -------------------------------------------------------------
# Veritas ID can show people the bans txAdmin holds against them. txAdmin
# keeps none of that in the game database - it is a JSON file beside the
# server, normally txData/<profile>/data/playersDB.json.
#
# Leave empty and the panel looks for a txData folder near itself, which
# covers the usual case of the panel living inside the server directory.
# Otherwise point this at txData, at a profile folder, or at the file.
# The panel only ever reads it.
TXADMIN_DB_PATH=

# Whether a player is told which admin issued their ban. Off by default:
# the reason is their business, the name of the staff member who typed it
# is the server owner's decision.
TXADMIN_SHOW_BAN_AUTHOR=false

# --- Development ---------------------------------------------------------
# Address of the Vite server, for example http://localhost:5173.
# Leave EMPTY in production: the same backend then serves the panel, same
# origin, no CORS needed.
#
# One variable for both - it names the allowed CORS origin AND the target
# after signing in. In development those are necessarily the same address;
# two separate switches would only be two chances to mix them up.
PANEL_ORIGIN=
